# Required by pnpm 10's `pnpm deploy` (used by the API Dockerfile to
# produce a self-contained runtime image). Mirrored in pnpm-workspace.yaml
# for older pnpm versions that read the npmrc form instead.
inject-workspace-packages=true

# Node version is intentionally NOT pinned in this file. Newer Vercel CLIs
# reject the pnpm node-version key here and fail the build. The Node 20 pin
# now lives in engines.node (package.json), useNodeVersion
# (pnpm-workspace.yaml, for pnpm 10.6 and above), the node:20-alpine Docker
# base, .nvmrc, and the CI workflow. Keep those in step; Next 14.2.3 breaks
# on Node 22 and 24.

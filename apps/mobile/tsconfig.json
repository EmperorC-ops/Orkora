{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@orkora/theme": ["../../packages/theme/src/index.ts"],
      "@orkora/theme/*": ["../../packages/theme/src/*"],
      "@orkora/ui": ["../../packages/ui/src/index.ts"],
      "@orkora/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}

# Public origins used by the Next app at build and run time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. When set to 'staging' a persistent banner is rendered on every
# page warning operators that the deploy is not production. Any value other
# than 'staging' (including empty) hides the banner. Set to 'staging' on the
# Vercel staging project only.
# NEXT_PUBLIC_APP_ENV=staging

# Cloudflare Turnstile site key (public). When set, signup, the sign-in code
# request, registration and VIP registration show the bot check. Leave unset
# until the API has TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

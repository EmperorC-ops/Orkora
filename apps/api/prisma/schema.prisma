// Prisma schema for EventApp
// See schema.sql at the repo root for the raw SQL source of truth (including RLS policies).
// This Prisma schema mirrors it for application access.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ========== IDENTITY + TENANCY ==========

model Organization {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String   @unique
  name          String
  logoUrl       String?  @map("logo_url")
  brandColor    String?  @default("#6D28D9") @map("brand_color")
  plan          String   @default("starter")
  // Platform lifecycle: "active" | "suspended". A super admin can suspend an
  // org from the platform console; suspended orgs are hidden from the public
  // and blocked from new registrations.
  status        String   @default("active")
  countryCode   String   @default("NG") @map("country_code") @db.Char(2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships         Membership[]
  events              Event[]
  walletEntries       WalletEntry[]
  apiKeys             ApiKey[]
  paymentPreferences  PaymentProviderPreference[]

  @@map("organizations")
}

model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String    @unique @db.Citext
  phone         String?
  passwordHash  String?   @map("password_hash")
  fullName      String    @map("full_name")
  avatarUrl     String?   @map("avatar_url")
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  locale        String    @default("en-NG")
  // Platform-wide role, distinct from per-org membership roles:
  //   "none"       - a normal user (organizer and/or attendee)
  //   "support"    - Orkora staff with read access to the platform console
  //   "superadmin" - Orkora master account: full cross-org control
  platformRole  String    @default("none") @map("platform_role")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  registrations  Registration[]
  orders         Order[]
  walletEntries  WalletEntry[]
  messages       Message[]
  pollVotes      PollVote[]
  messageUpvotes MessageUpvote[]
  apiKeysCreated ApiKey[]       @relation("ApiKeyCreatedBy")

  @@map("users")
}

model Membership {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  deviceFingerprint String?   @map("device_fingerprint")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Invitation {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  role           String
  invitedById    String    @map("invited_by_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invitations")
}

model OtpCode {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  destination String
  channel     String
  codeHash    String    @map("code_hash")
  purpose     String
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([destination, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

// ========== EVENTS ==========

model Event {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  code            String   @unique
  slug            String
  title           String
  description     String?
  kind            String
  startAt         DateTime @map("start_at") @db.Timestamptz
  endAt           DateTime @map("end_at") @db.Timestamptz
  timezone        String   @default("Africa/Lagos")
  capacity        Int?
  waitlistEnabled Boolean  @default(false) @map("waitlist_enabled")
  bannerUrl       String?  @map("banner_url")
  theme           Json     @default("{}")
  status          String   @default("draft")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  sessions      Session[]
  tracks        Track[]
  speakers      Speaker[]
  tiers         TicketTier[]
  registrations Registration[]
  orders        Order[]
  channels      Channel[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("events")
}

model Track {
  id      String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId String  @map("event_id") @db.Uuid
  name    String
  color   String?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([eventId])
  @@map("tracks")
}

model Session {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  trackId      String?  @map("track_id") @db.Uuid
  title        String
  description  String?
  startAt      DateTime @map("start_at") @db.Timestamptz
  endAt        DateTime @map("end_at") @db.Timestamptz
  streamUrl    String?  @map("stream_url")
  capacity     Int?
  requiresRsvp Boolean  @default(false) @map("requires_rsvp")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track    Track?    @relation(fields: [trackId], references: [id])
  channels Channel[]
  polls    Poll[]

  @@index([eventId, startAt])
  @@map("sessions")
}

model Speaker {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  fullName    String  @map("full_name")
  title       String?
  bio         String?
  avatarUrl   String? @map("avatar_url")
  socialLinks Json    @default("{}") @map("social_links")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("speakers")
}

// ========== TICKETING ==========

model TicketTier {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  name          String
  description   String?
  priceMinor    BigInt    @default(0) @map("price_minor")
  currency      String    @default("NGN") @db.Char(3)
  quantityTotal Int?      @map("quantity_total")
  quantitySold  Int       @default(0) @map("quantity_sold")
  minPerOrder   Int       @default(1) @map("min_per_order")
  maxPerOrder   Int       @default(10) @map("max_per_order")
  saleStartsAt  DateTime? @map("sale_starts_at") @db.Timestamptz
  saleEndsAt    DateTime? @map("sale_ends_at") @db.Timestamptz
  isGroup       Boolean   @default(false) @map("is_group")
  groupSize     Int?      @map("group_size")
  position      Int       @default(0)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  orderItems OrderItem[]

  @@index([eventId, position])
  @@map("ticket_tiers")
}

model Registration {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  status        String   @default("pending")
  formResponses Json     @default("{}") @map("form_responses")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  tickets Ticket[]
  orders  Order[]

  @@unique([eventId, userId])
  @@map("registrations")
}

model Ticket {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  registrationId String    @map("registration_id") @db.Uuid
  tierId         String    @map("tier_id") @db.Uuid
  code           String    @unique
  holderName     String    @map("holder_name")
  holderEmail    String    @map("holder_email") @db.Citext
  status         String    @default("issued")
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  checkedInAt    DateTime? @map("checked_in_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tier         TicketTier   @relation(fields: [tierId], references: [id])

  @@index([registrationId])
  @@index([status])
  @@map("tickets")
}

// ========== PAYMENTS ==========

model Order {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  registrationId String?   @map("registration_id") @db.Uuid
  subtotalMinor  BigInt    @map("subtotal_minor")
  feesMinor      BigInt    @default(0) @map("fees_minor")
  totalMinor     BigInt    @map("total_minor")
  currency       String    @db.Char(3)
  status         String    @default("pending")
  provider       String?
  providerRef    String?   @map("provider_ref")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  // Set when a refund is requested upstream. The order stays `paid` until the
  // refund is confirmed (synchronously by the provider, by webhook, or by the
  // refund reconciliation sweep), at which point status flips to `refunded`.
  // This is the in-flight marker reconcileRefunds() scans for.
  refundInitiatedAt DateTime? @map("refund_initiated_at") @db.Timestamptz

  event        Event         @relation(fields: [eventId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  items        OrderItem[]

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  tierId         String @map("tier_id") @db.Uuid
  quantity       Int
  unitPriceMinor BigInt @map("unit_price_minor")

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier  TicketTier @relation(fields: [tierId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model WalletEntry {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.Char(3)
  reason         String
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_entries")
}

// ========== ENGAGEMENT ==========

model Channel {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid
  kind      String
  title     String?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session  Session?  @relation(fields: [sessionId], references: [id])
  messages Message[]

  @@index([eventId, kind])
  @@map("channels")
}

model Message {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String
  replyToId String?   @map("reply_to_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  channel Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])
  replyTo Message?        @relation("MessageReplies", fields: [replyToId], references: [id])
  replies Message[]       @relation("MessageReplies")
  upvotes MessageUpvote[]

  @@index([channelId, createdAt])
  @@map("messages")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json     @default("{}")
  requestId      String?  @map("request_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

model WebhookEvent {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz
  outcome         String?

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

model MessageUpvote {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_upvotes")
}

model Poll {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  question    String
  options     Json
  status      String    @default("draft")
  multiSelect Boolean   @default(false) @map("multi_select")
  closedAt    DateTime? @map("closed_at") @db.Timestamptz

  session Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes   PollVote[]

  @@index([sessionId])
  @@map("polls")
}

model PollVote {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  optionIds String[] @map("option_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
  @@map("poll_votes")
}

model ApiKey {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  tokenHash      String    @unique @map("token_hash")
  lastFour       String    @map("last_four")
  scopes         String[]  @default([])
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("api_keys")
}

model PaymentProviderPreference {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  currency       String   @db.Char(3)
  provider       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, currency])
  @@index([organizationId])
  @@map("payment_provider_preferences")
}

// Prisma schema for EventApp
// See schema.sql at the repo root for the raw SQL source of truth (including RLS policies).
// This Prisma schema mirrors it for application access.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ========== IDENTITY + TENANCY ==========

model Organization {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String   @unique
  name          String
  logoUrl       String?  @map("logo_url")
  brandColor    String?  @default("#6D28D9") @map("brand_color")
  plan          String   @default("starter")
  // Platform lifecycle: "active" | "suspended". A super admin can suspend an
  // org from the platform console; suspended orgs are hidden from the public
  // and blocked from new registrations.
  status        String   @default("active")
  countryCode   String   @default("NG") @map("country_code") @db.Char(2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships         Membership[]
  events              Event[]
  walletEntries       WalletEntry[]
  apiKeys             ApiKey[]
  paymentPreferences  PaymentProviderPreference[]
  campaigns           Campaign[]
  campaignAudiences   CampaignAudience[]
  campaignSends       CampaignSend[]
  emailSuppressions   EmailSuppression[]
  eventFeedback       EventFeedback[]

  @@map("organizations")
}

model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String    @unique @db.Citext
  phone         String?
  passwordHash  String?   @map("password_hash")
  fullName      String    @map("full_name")
  avatarUrl     String?   @map("avatar_url")
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  locale        String    @default("en-NG")
  // Platform-wide role, distinct from per-org membership roles:
  //   "none"       - a normal user (organizer and/or attendee)
  //   "support"    - Orkora staff with read access to the platform console
  //   "superadmin" - Orkora master account: full cross-org control
  platformRole  String    @default("none") @map("platform_role")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  registrations  Registration[]
  orders         Order[]
  walletEntries  WalletEntry[]
  messages       Message[]
  pollVotes      PollVote[]
  messageUpvotes MessageUpvote[]
  apiKeysCreated ApiKey[]       @relation("ApiKeyCreatedBy")
  campaignsCreated         Campaign[]         @relation("CampaignCreatedBy")
  campaignAudiencesCreated CampaignAudience[] @relation("CampaignAudienceCreatedBy")
  campaignSendsReceived    CampaignSend[]     @relation("CampaignSendUser")
  eventFeedback            EventFeedback[]
  discountRedemptions      DiscountRedemption[]

  @@map("users")
}

model Membership {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  deviceFingerprint String?   @map("device_fingerprint")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Invitation {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  role           String
  invitedById    String    @map("invited_by_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("invitations")
}

/// Tracks consecutive failed password-login attempts per email so we can enforce
/// per-account exponential backoff. The per-IP throttler protects against a
/// single attacker hammering one machine; this table protects a single account
/// against a slow, distributed brute-force across many IPs. Cleared on first
/// successful login.
model LoginFailure {
  emailLower   String    @id @map("email_lower")
  failedCount  Int       @default(0) @map("failed_count")
  lastFailedAt DateTime  @default(now()) @map("last_failed_at") @db.Timestamptz
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz

  @@map("login_failures")
}

model OtpCode {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  destination String
  channel     String
  codeHash    String    @map("code_hash")
  purpose     String
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([destination, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

// ========== EVENTS ==========

model Event {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  code            String   @unique
  slug            String
  title           String
  description     String?
  kind            String
  startAt         DateTime @map("start_at") @db.Timestamptz
  endAt           DateTime @map("end_at") @db.Timestamptz
  timezone        String   @default("Africa/Lagos")
  capacity        Int?
  waitlistEnabled Boolean  @default(false) @map("waitlist_enabled")
  bannerUrl       String?  @map("banner_url")
  theme           Json     @default("{}")
  status          String   @default("draft")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id])
  sessions      Session[]
  tracks        Track[]
  speakers      Speaker[]
  tiers         TicketTier[]
  registrations Registration[]
  orders        Order[]
  channels      Channel[]
  feedback      EventFeedback[]
  discountCodes DiscountCode[]
  recordings    Recording[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
    campaigns          Campaign[]
  campaignAudiences  CampaignAudience[]

  @@map("events")
}

model Track {
  id      String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId String  @map("event_id") @db.Uuid
  name    String
  color   String?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([eventId])
  @@map("tracks")
}

model Session {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  trackId      String?  @map("track_id") @db.Uuid
  title        String
  description  String?
  startAt      DateTime @map("start_at") @db.Timestamptz
  endAt        DateTime @map("end_at") @db.Timestamptz
  streamUrl    String?  @map("stream_url")
  capacity     Int?
  requiresRsvp Boolean  @default(false) @map("requires_rsvp")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track    Track?    @relation(fields: [trackId], references: [id])
  channels Channel[]
  polls    Poll[]
  feedback EventFeedback[]
  recordings Recording[]

  @@index([eventId, startAt])
  @@map("sessions")
}

model Speaker {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid
  fullName    String  @map("full_name")
  title       String?
  bio         String?
  avatarUrl   String? @map("avatar_url")
  socialLinks Json    @default("{}") @map("social_links")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("speakers")
}

// ========== TICKETING ==========

model TicketTier {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  name          String
  description   String?
  priceMinor    BigInt    @default(0) @map("price_minor")
  currency      String    @default("NGN") @db.Char(3)
  quantityTotal Int?      @map("quantity_total")
  quantitySold  Int       @default(0) @map("quantity_sold")
  minPerOrder   Int       @default(1) @map("min_per_order")
  maxPerOrder   Int       @default(10) @map("max_per_order")
  saleStartsAt  DateTime? @map("sale_starts_at") @db.Timestamptz
  saleEndsAt    DateTime? @map("sale_ends_at") @db.Timestamptz
  isGroup       Boolean   @default(false) @map("is_group")
  groupSize     Int?      @map("group_size")
  position      Int       @default(0)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Ticket[]
  orderItems OrderItem[]
  recordings Recording[]

  @@index([eventId, position])
  @@map("ticket_tiers")
}

model Registration {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  status        String   @default("pending")
  formResponses Json     @default("{}") @map("form_responses")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  tickets Ticket[]
  orders  Order[]

  @@unique([eventId, userId])
  @@map("registrations")
}

model DiscountCode {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  code           String
  // 'percent' (value = 1..100) or 'fixed' (value = amount in minor units).
  kind           String
  value          Int
  // Only meaningful for 'fixed' codes: the currency the fixed amount is in.
  currency       String?   @db.Char(3)
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  startsAt       DateTime? @map("starts_at") @db.Timestamptz
  endsAt         DateTime? @map("ends_at") @db.Timestamptz
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  redemptions DiscountRedemption[]
  orders      Order[]

  @@unique([eventId, code])
  @@index([eventId])
  @@map("discount_codes")
}

model DiscountRedemption {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  discountCodeId String   @map("discount_code_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([discountCodeId])
  @@map("discount_redemptions")
}

model Recording {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.Uuid
  title          String
  description    String?
  // 'link' (external url: YouTube/Vimeo/HLS) or 'upload' (R2 storage key).
  source         String
  url            String?
  storageKey     String?   @map("storage_key")
  durationSec    Int?      @map("duration_sec")
  // 'public' (anyone), 'ticket' (any ticket holder), 'tier' (a specific tier).
  visibility     String    @default("ticket")
  requiredTierId String?   @map("required_tier_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  requiredTier TicketTier? @relation(fields: [requiredTierId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([sessionId])
  @@map("recordings")
}

model EventFeedback {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  attendeeEmail  String?  @map("attendee_email")
  rating         Int?     @db.SmallInt
  npsScore       Int?     @map("nps_score") @db.SmallInt
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([eventId, createdAt])
  @@index([sessionId])
  @@index([organizationId])
  @@map("event_feedback")
}

model Ticket {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  registrationId String    @map("registration_id") @db.Uuid
  tierId         String    @map("tier_id") @db.Uuid
  // The order that issued this ticket. Set whenever a paid registration
  // creates tickets; NULL for free-tier tickets and legacy rows backfilled
  // by migration 0004. The payments service scopes ticket lifecycle updates
  // by this column when set, so an abandoned order's cancel or a refund only
  // touches its own tickets, not siblings from the same registration.
  orderId        String?   @map("order_id") @db.Uuid
  code           String    @unique
  holderName     String    @map("holder_name")
  holderEmail    String    @map("holder_email") @db.Citext
  // Lifecycle: 'pending' (held for a paid order awaiting payment), 'issued'
  // (valid for check-in), 'cancelled' (issuing order failed before payment),
  // 'void' (issuing order was refunded after payment, QR no longer admits).
  status         String    @default("issued")
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  checkedInAt    DateTime? @map("checked_in_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tier         TicketTier   @relation(fields: [tierId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([status])
  @@index([orderId])
  @@map("tickets")
}

// ========== PAYMENTS ==========

model Order {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  registrationId String?   @map("registration_id") @db.Uuid
  subtotalMinor  BigInt    @map("subtotal_minor")
  feesMinor      BigInt    @default(0) @map("fees_minor")
  discountMinor  BigInt    @default(0) @map("discount_minor")
  discountCodeId String?   @map("discount_code_id") @db.Uuid
  totalMinor     BigInt    @map("total_minor")
  currency       String    @db.Char(3)
  status         String    @default("pending")
  provider       String?
  providerRef    String?   @map("provider_ref")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  // Set when a refund is requested upstream. The order stays `paid` until the
  // refund is confirmed (synchronously by the provider, by webhook, or by the
  // refund reconciliation sweep), at which point status flips to `refunded`.
  // This is the in-flight marker reconcileRefunds() scans for.
  refundInitiatedAt DateTime? @map("refund_initiated_at") @db.Timestamptz

  event        Event              @relation(fields: [eventId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  registration Registration?      @relation(fields: [registrationId], references: [id])
  discountCode DiscountCode?      @relation(fields: [discountCodeId], references: [id])
  discountRedemption DiscountRedemption?
  items        OrderItem[]
  tickets      Ticket[]
  notifications NotificationLog[]

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

/// Idempotency log for order-side notifications. Inserted in the same
/// transaction that flips order status (paid / refunded), so any competing
/// settlement path (verify-on-action, webhook, reconcile) that tries to send
/// the same `kind` for the same `orderId` will hit the unique constraint and
/// silently skip the send. Guarantees exactly-one email per (order, kind).
model NotificationLog {
  id      String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId String   @map("order_id") @db.Uuid
  kind    String
  sentAt  DateTime @default(now()) @map("sent_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([orderId])
  @@map("notification_log")
}

model OrderItem {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  tierId         String @map("tier_id") @db.Uuid
  quantity       Int
  unitPriceMinor BigInt @map("unit_price_minor")

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier  TicketTier @relation(fields: [tierId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model WalletEntry {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.Char(3)
  reason         String
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_entries")
}

// ========== ENGAGEMENT ==========

model Channel {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId   String  @map("event_id") @db.Uuid
  sessionId String? @map("session_id") @db.Uuid
  kind      String
  title     String?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session  Session?  @relation(fields: [sessionId], references: [id])
  messages Message[]

  @@index([eventId, kind])
  @@map("channels")
}

model Message {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channelId String    @map("channel_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  body      String
  replyToId String?   @map("reply_to_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  // Q&A moderation: when an organizer marks a question answered.
  answeredAt DateTime? @map("answered_at") @db.Timestamptz

  channel Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])
  replyTo Message?        @relation("MessageReplies", fields: [replyToId], references: [id])
  replies Message[]       @relation("MessageReplies")
  upvotes MessageUpvote[]

  @@index([channelId, createdAt])
  @@map("messages")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json     @default("{}")
  requestId      String?  @map("request_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

model WebhookEvent {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz
  outcome         String?

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

model MessageUpvote {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_upvotes")
}

model Poll {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  question    String
  options     Json
  status      String    @default("draft")
  multiSelect Boolean   @default(false) @map("multi_select")
  closedAt    DateTime? @map("closed_at") @db.Timestamptz

  session Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes   PollVote[]

  @@index([sessionId])
  @@map("polls")
}

model PollVote {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  optionIds String[] @map("option_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
  @@map("poll_votes")
}

model ApiKey {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  tokenHash      String    @unique @map("token_hash")
  lastFour       String    @map("last_four")
  scopes         String[]  @default([])
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("api_keys")
}

model PaymentProviderPreference {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  currency       String   @db.Char(3)
  provider       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, currency])
  @@index([organizationId])
  @@map("payment_provider_preferences")
}

// ---------- Campaigns ----------

// Campaign is an organizer-initiated email send. Distinct from
// transactional emails (otp, receipt, refund) which go via
// NotificationsService. Slice A: list, create, send-now, schedule
// (Slice B), drip triggers (Slice C). See CAMPAIGNS_SPEC.md.
model Campaign {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  eventId         String?  @map("event_id") @db.Uuid
  name            String
  subject         String
  previewText     String?  @map("preview_text")
  bodyMarkdown    String   @map("body_markdown")
  bodyHtml        String   @map("body_html")
  fromName        String   @map("from_name")
  fromEmail       String   @map("from_email")
  replyTo         String?  @map("reply_to")
  status          String   @default("draft") // draft | scheduled | sending | sent | cancelled | failed
  sendMode        String   @default("now") @map("send_mode") // now | scheduled | triggered
  scheduledAt     DateTime? @map("scheduled_at") @db.Timestamptz
  triggerSpec     Json?     @map("trigger_spec")
  audienceId      String    @map("audience_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sentStartedAt   DateTime? @map("sent_started_at") @db.Timestamptz
  sentCompletedAt DateTime? @map("sent_completed_at") @db.Timestamptz
  recipientCount  Int       @default(0) @map("recipient_count")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  audience     CampaignAudience  @relation(fields: [audienceId], references: [id])
  createdBy    User              @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  sends        CampaignSend[]

  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, eventId])
  @@map("campaigns")
}

// CampaignAudience defines who a campaign goes to. Smart segments are
// pre-named queries the materialiser knows how to expand; custom
// segments hold a JSON spec of AND'd conditions (Slice B).
model CampaignAudience {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  eventId         String?  @map("event_id") @db.Uuid
  name            String
  kind            String   // smart | custom
  smartKey        String?  @map("smart_key") // e.g. all-registrations, checked-in, tier:<id>
  customSpec      Json?    @map("custom_spec")
  cachedCount     Int      @default(0) @map("cached_count")
  cachedAt        DateTime? @map("cached_at") @db.Timestamptz
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("CampaignAudienceCreatedBy", fields: [createdById], references: [id])
  campaigns    Campaign[]

  @@index([organizationId, kind])
  @@index([organizationId, eventId])
  @@map("campaign_audiences")
}

// CampaignSend is the per-recipient send record. One row per recipient
// per campaign. Postmark webhooks update status as the message travels
// through the delivery pipeline.
model CampaignSend {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  campaignId        String    @map("campaign_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  recipientEmail    String    @map("recipient_email") @db.Citext
  recipientName     String?   @map("recipient_name")
  status            String    @default("queued") // queued | sent | delivered | bounced | opened | clicked | unsubscribed | complained | failed
  postmarkMessageId String?   @map("postmark_message_id")
  queuedAt          DateTime  @default(now()) @map("queued_at") @db.Timestamptz
  sentAt            DateTime? @map("sent_at") @db.Timestamptz
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz
  firstOpenedAt     DateTime? @map("first_opened_at") @db.Timestamptz
  firstClickedAt    DateTime? @map("first_clicked_at") @db.Timestamptz
  bouncedAt         DateTime? @map("bounced_at") @db.Timestamptz
  unsubscribedAt    DateTime? @map("unsubscribed_at") @db.Timestamptz

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("CampaignSendUser", fields: [userId], references: [id])

  @@unique([campaignId, recipientEmail])
  @@index([organizationId, status])
  @@index([postmarkMessageId])
  @@map("campaign_sends")
}

// EmailSuppression: per-org gag list. A hard bounce, complaint, or
// unsubscribe writes a row; the campaign send pipeline skips matching
// rows. Per-org so an unsub on Org A does not silence Org B.
model EmailSuppression {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  email           String   @db.Citext
  reason          String   // bounce | complaint | unsubscribe | manual
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, reason])
  @@map("email_suppressions")
}

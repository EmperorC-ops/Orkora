NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

DATABASE_URL=postgresql://orkora:orkora@localhost:5432/orkora?schema=public
REDIS_URL=redis://localhost:6379

# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the full PEM blocks here (including -----BEGIN/END----- lines).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REFRESH_TOKEN_PEPPER=change-me-to-32-bytes-of-random-data
TICKET_SIGNING_SECRET=change-me-to-32-bytes-of-random-data
ORDER_HOLD_TTL_MIN=20
# Payment maintenance sweeps (stale-hold release + reconciliation). The 15-minute
# sweep only queries the database when an order was created/checked out recently,
# so an idle API lets Neon compute suspend. The daily sweep is unconditional.
PAYMENTS_SWEEP_CRON="*/15 * * * *"
PAYMENTS_DAILY_SWEEP_CRON="0 4 * * *"

AWS_REGION=eu-west-1

# Media storage. Local dev uses the MinIO container in infra/docker. In
# production these point at AWS S3 or Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=orkora
S3_SECRET_ACCESS_KEY=orkora-dev
S3_BUCKET_MEDIA=orkora-dev-media
S3_PUBLIC_BASE_URL=http://localhost:9000/orkora-dev-media
S3_FORCE_PATH_STYLE=true

# Notifications. If unset, email and SMS fall back to console output for local dev.
POSTMARK_TOKEN=
TERMII_API_KEY=
TWILIO_SID=
TWILIO_AUTH_TOKEN=

# Social login audiences. Set to your OAuth client IDs in production.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Payments. Get test keys from https://dashboard.stripe.com/test/apikeys.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to ...`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

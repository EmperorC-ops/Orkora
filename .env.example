# Copy to .env and fill in. Never commit .env.
# This file is the source of truth for required env vars in local dev.

# === Core ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# === Database ===
DATABASE_URL=postgresql://orkora:orkora@localhost:5432/orkora?schema=public
REDIS_URL=redis://localhost:6379

# === Auth ===
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then base64 encode each PEM file (single line, no header) for easier env transport.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
REFRESH_TOKEN_PEPPER=change-me-in-production

# === Storage ===
AWS_REGION=eu-west-1
S3_BUCKET_MEDIA=orkora-dev-media
S3_BUCKET_EXPORTS=orkora-dev-exports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Email + SMS ===
POSTMARK_TOKEN=
TERMII_API_KEY=
TWILIO_SID=
TWILIO_AUTH_TOKEN=

# === Payments ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# === Push ===
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=io.orkora.attendee

# === Observability ===
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === Web (Next.js) ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BRAND_NAME=Orkora

# === Mobile (Expo) ===
EXPO_PUBLIC_API_URL=http://localhost:4000
